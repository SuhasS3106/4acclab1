import random
import simpy

class Datacenter:
    def __init__(self,env,vm_count,mips):
        self.env=env
        self.vms=simpy.Resource(env,capacity=vm_count)
        self.mips=mips

    def execute_cloudlet(self,mi):
        execution_time=mi/self.mips
        yield self.env.timeout(execution_time)

def cloudlet_lifecycle(env,datacenter,cloudlet_id,mi):
    arrival_time=env.now
    print(f"[Global Time {env.now:5.2f}]Time {arrival_time:05.2f}] Cloudlet-{cloudlet_id} arrived. (Length: {mi} MI)")
    with datacenter.vms.request() as request:
        yield request

        start_time=env.now
        wait_time=start_time-arrival_time
        print(f"[Global Time {env.now:5.2f}][Time {start_time:05.2f}] Cloudlet-{cloudlet_id} started on VM. (Wait Time: {wait_time:.2f}s)")

        yield env.process(datacenter.execute_cloudlet(mi))

        finish_time=env.now
        print(f"[Global Time {env.now:5.2f} ][Time {finish_time:05.2f}] Cloudlet-{cloudlet_id} finished. (Total Time: {finish_time - arrival_time:.2f}s)\n")


def workload_generator(env,datacenter,cloudlet_count):
    for i in range(cloudlet_count):
        mi=random.randint(1000,5000)
        env.process(cloudlet_lifecycle(env,datacenter,cloudlet_id=i+1,mi=mi))
        yield env.timeout(random.uniform(0.5,2.0))

print("=== Starting Cloud FCFS Scheduling Simulation ===\n")
    
env = simpy.Environment()

NUM_VMS = int(input("Enter number of VMs needed "))
VM_MIPS = int(input("Enter VM capacity (in million instruction per second) "))
datacenter = Datacenter(env, vm_count=NUM_VMS, mips=VM_MIPS)

NUM_TASKS = int(input("Enter number of tasks to be simulated "))
env.process(workload_generator(env, datacenter, cloudlet_count=NUM_TASKS))

env.run()
